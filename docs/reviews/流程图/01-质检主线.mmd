%% 当前6001流程：2026-09-23；按钮映射见 ../流程节点与操作按钮核查-20260923.md
flowchart TD
    A(["开始：<br/>通话接入·<br/>录音与转写"]) --> B["执行指标检测<br/>并按预警策略判断"]
    B --> C{"是否满足<br/>已发布<br/>预警策略？"}

    C -->|否| D["保存检测结果·<br/>可人工抽检"]
    D --> AA{"是否发起<br/>人工抽检？"}
    AA -->|否| E(["结束：未触发预警"])
    AA -->|是| AB["主管创建人工抽检工单<br/>指定质检员、<br/>检查范围及期限"]
    AB --> AC{"质检员<br/>人工抽检<br/>是否发现<br/>问题？"}
    AC -->|否| AD["提交抽检范围、记录<br/>及未发现问题结果"]
    AD --> AE{"主管是否确认<br/>抽检结果？"}
    AE -->|否| AF["说明退回原因<br/>及检查要求"]
    AF --> AC
    AE -->|是| AG(["结束：<br/>人工抽检完成·<br/>未发现问题"])
    AC -->|是| AH["登记人工发现问题<br/>提交核实结果<br/>及证据"]
    AH --> AI{"主管是否确认<br/>发现的问题？"}
    AI -->|是| R
    AI -->|否| AJ["说明退回原因<br/>及检查要求"]
    AJ --> AC
    C -->|是| F["生成预警·<br/>附规则与证据"]

    F --> G["主管查看预警<br/>并分拣"]
    G --> H{"是否判定<br/>为误报？"}

    H -->|是| I["记录误报原因<br/>并归档<br/>纳入规则优化反馈"]
    I --> J(["结束：误报归档"])

    H -->|否，或尚需核实| K{"是否需要<br/>质检员核实？"}
    K -->|否，直接提醒| R["主管分发处理结果<br/>及要求给坐席"]

    K -->|是| L["创建复核工单<br/>指定质检员、<br/>核实事项及期限"]
    L --> M["质检员核实<br/>并提交结果<br/>误报或非误报，<br/>附依据"]
    M --> N{"主管是否确认<br/>复核结果？"}

    N -->|否| O["说明退回原因<br/>及核实要求"]
    O --> M
    N -->|是| P{"确认结果是否<br/>为误报？"}

    P -->|是| I
    P -->|否| R

    R --> S["坐席查看处理结果<br/>及要求"]
    S --> T{"坐席是否<br/>接受？"}

    T -->|接受| U[["进入整改子流程"]]
    T -->|不接受| V[["进入申诉子流程"]]

    classDef default fill:#f0f4fc,stroke:#000000,color:#1f2329;
    classDef decision fill:#fef1ce,stroke:#000000,color:#1f2329;
    classDef terminal fill:#eae2fe,stroke:#000000,color:#1f2329;
    class C,AA,AC,AE,AI,H,K,N,P,T decision;
    class A,E,AG,J,U,V terminal;
